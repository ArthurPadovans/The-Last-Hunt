falas = [
    ["velho", "Sentem-se, criancas. Hoje eu conto a historia de Charles Logan."],
    ["povo", "Ele era um heroi?"],
    ["velho", "Nao sei se heroi. Era um cacador. Um homem sozinho contra a gangue mais temida do Oeste."],
    ["povo", "E ele venceu?"],
    ["velho", "Venceu. Derrubou o chefe deles e tombou ali mesmo, ao lado dele."],
    ["povo", "Que triste."],
    ["velho", "Triste, talvez. Mas repare: eu nunca o vi na vida, e aqui estou eu, contando a historia dele para voces."],
    ["velho", "E um dia voces vao contar para os filhos de voces."]
];

